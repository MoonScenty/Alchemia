{
  "multipart": [
    {
      "apply": {
        "model": "alchemia:block/tube/middle_buffer"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm_down"
      },
      "when": {
        "down": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar_down"
      },
      "when": {
        "down": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm_up"
      },
      "when": {
        "up": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar_up"
      },
      "when": {
        "up": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm",
        "y": 270
      },
      "when": {
        "north": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar",
        "y": 270
      },
      "when": {
        "north": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm",
        "y": 90
      },
      "when": {
        "south": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar",
        "y": 90
      },
      "when": {
        "south": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm",
        "y": 180
      },
      "when": {
        "west": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar",
        "y": 180
      },
      "when": {
        "west": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm"
      },
      "when": {
        "east": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar"
      },
      "when": {
        "east": "block"
      }
    }
  ]
}