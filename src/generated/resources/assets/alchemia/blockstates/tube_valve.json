{
  "multipart": [
    {
      "apply": {
        "model": "alchemia:block/tube/middle_plain"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm_down"
      },
      "when": {
        "down": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar_down"
      },
      "when": {
        "down": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm_up"
      },
      "when": {
        "up": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar_up"
      },
      "when": {
        "up": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm",
        "y": 270
      },
      "when": {
        "north": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar",
        "y": 270
      },
      "when": {
        "north": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm",
        "y": 90
      },
      "when": {
        "south": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar",
        "y": 90
      },
      "when": {
        "south": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm",
        "y": 180
      },
      "when": {
        "west": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar",
        "y": 180
      },
      "when": {
        "west": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arm"
      },
      "when": {
        "east": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/collar"
      },
      "when": {
        "east": "block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_shut_down"
      },
      "when": {
        "facing": "down",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_open_down"
      },
      "when": {
        "facing": "down",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_shut_up"
      },
      "when": {
        "facing": "up",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_open_up"
      },
      "when": {
        "facing": "up",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_shut",
        "y": 270
      },
      "when": {
        "facing": "north",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_open",
        "y": 270
      },
      "when": {
        "facing": "north",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_shut",
        "y": 90
      },
      "when": {
        "facing": "south",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_open",
        "y": 90
      },
      "when": {
        "facing": "south",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_shut",
        "y": 180
      },
      "when": {
        "facing": "west",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_open",
        "y": 180
      },
      "when": {
        "facing": "west",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_shut"
      },
      "when": {
        "facing": "east",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/handle_open"
      },
      "when": {
        "facing": "east",
        "open": "true"
      }
    }
  ]
}