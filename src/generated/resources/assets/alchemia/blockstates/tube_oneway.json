{
  "multipart": [
    {
      "apply": {
        "model": "alchemia:block/tube"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arrow_down"
      },
      "when": {
        "down": "tube|block",
        "facing": "down"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arrow_up"
      },
      "when": {
        "facing": "up",
        "up": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arrow",
        "y": 270
      },
      "when": {
        "facing": "north",
        "north": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arrow",
        "y": 90
      },
      "when": {
        "facing": "south",
        "south": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arrow",
        "y": 180
      },
      "when": {
        "facing": "west",
        "west": "tube|block"
      }
    },
    {
      "apply": {
        "model": "alchemia:block/tube/arrow"
      },
      "when": {
        "east": "tube|block",
        "facing": "east"
      }
    }
  ]
}